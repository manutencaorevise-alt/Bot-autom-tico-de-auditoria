{
  "version": 2,
  "builds": [
    {
      "src": "whatsapp_bot.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "whatsapp_bot.py"
    }
  ],
  "env": {
    "TWILIO_ACCOUNT_SID": "@twilio_account_sid",
    "TWILIO_AUTH_TOKEN": "@twilio_auth_token",
    "TWILIO_PHONE": "@twilio_phone",
    "CLAUDE_API_KEY": "@claude_api_key"
  }
}
